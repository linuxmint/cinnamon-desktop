<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <!-- The values mirror CinnamonBgMode in cinnamon's background library, which
       reads this key with g_settings_get_enum(). Keep the numbering in step. -->
  <enum id="org.cinnamon.desktop.BackgroundMode">
    <value value="0" nick="independent"/>
    <value value="1" nick="mirror"/>
    <value value="2" nick="spanned"/>
  </enum>

  <schema id="org.cinnamon.desktop.background" path="/org/cinnamon/desktop/background/">
    <key name="picture-options" enum="org.cinnamon.desktop.CDesktopBackgroundStyle">
      <default>'zoom'</default>
      <summary>Picture Options</summary>
      <description>
        DEPRECATED, no longer used (superseded by picture-uri-list).
        Determines how the image set by wallpaper_filename is rendered.
        Possible values are "none", "wallpaper", "centered", "scaled",
        "stretched", "zoom", "spanned".
      </description>
    </key>
    <key name="picture-uri" type="s">
      <default>'file://@datadir@/themes/Adwaita/backgrounds/adwaita-timed.xml'</default>
      <summary>Picture URI</summary>
      <description>
        URI to use for the background image. Note that the backend only supports
        local (file://) URIs.
        The classic single-background key: read as the fallback whenever
        picture-uri-list is empty, and still honoured as the external "set as
        wallpaper" entry point in any mode.
      </description>
    </key>
    <key name="background-mode" enum="org.cinnamon.desktop.BackgroundMode">
      <default>'mirror'</default>
      <summary>Background mode</summary>
      <description>
        How the per-monitor entries in picture-uri-list are edited and rendered:
        'independent' (each monitor its own background), 'mirror' (the same
        background on every monitor) or 'spanned' (one image stretched across
        the whole desktop).
      </description>
    </key>
    <key name="picture-uri-list" type="aa{sv}">
      <default>[]</default>
      <summary>Per-monitor background configuration</summary>
      <description>
        The stored background configuration, used by CinnamonBg. In 'independent'
        mode one entry per monitor, identified by connector its logical monitor
        index as fallback; in 'mirror' and 'spanned' a single entry with no index
        or connector.

        Keys: connector, index; picture-uri, picture-options;
        color-shading-type, primary-color, secondary-color; slideshow-source
        ("type://path") and slideshow.
      </description>
    </key>
    <key name="picture-opacity" type="i">
      <range min="0" max="100"/>
      <default>100</default>
      <summary>Picture Opacity</summary>
      <description>
        DEPRECATED, no longer used (the renderer does not apply opacity).
      </description>
    </key>
    <key name="primary-color" type="s">
      <default>'#000000'</default>
      <summary>Primary Color</summary>
      <description>
        DEPRECATED, no longer used (superseded by picture-uri-list).
        Left or Top color when drawing gradients, or the solid color.
      </description>
    </key>
    <key name="secondary-color" type="s">
      <default>'#000000'</default>
      <summary>Secondary Color</summary>
      <description>
        DEPRECATED, no longer used (superseded by picture-uri-list).
        Right or Bottom color when drawing gradients, not used for solid color.
      </description>
    </key>
    <key name="color-shading-type" enum="org.cinnamon.desktop.CDesktopBackgroundShading">
      <default>'solid'</default>
      <summary>Color Shading Type</summary>
      <description>
        DEPRECATED, no longer used (superseded by picture-uri-list).
        How to shade the background color. Possible values are "horizontal",
        "vertical", and "solid".
      </description>
    </key>
  </schema>

  <schema id="org.cinnamon.desktop.background.slideshow" path="/org/cinnamon/desktop/background/slideshow/">
    <key name="slideshow-enabled" type="b">
      <default>false</default>
      <summary>Whether or not to use a slideshow for the desktop background</summary>
      <description>
        DEPRECATED, no longer used (folded into the picture-uri-list entry's
        'slideshow' boolean). This key defines the whether the desktop background
        shows one single wallpaper, or a slideshow of images.
      </description>
    </key>
    <key name="image-source" type="s">
      <default>""</default>
      <summary>Source to use for the background slideshow</summary>
      <description>
        DEPRECATED, no longer used (folded into the picture-uri-list entry's
        'slideshow-source'). This key defines the source for the slideshow to get
        images from.
      </description>
    </key>
    <key name="delay" type="i">
      <default>15</default>
      <summary>Delay for the slideshow</summary>
      <description>
        This key defines the delay for the slideshow.
        In independent mode the change is staggered across monitors (delay/N apart).
      </description>
    </key>
    <key name="random-order" type="b">
      <default>false</default>
      <summary>Whether or not to play the images in random order</summary>
      <description>
        This key defines whether images are shown in order or chosen randomly.

        In independent mode, monitors sharing a folder avoid showing the same
        image where the folder holds enough of them.
      </description>
    </key>
    <key name="slideshow-paused" type="b">
      <default>false</default>
      <summary>Whether the slideshow is currently playing or paused</summary>
      <description>
        This key defines whether the slideshow in currently in a playing or paused state.
      </description>
    </key>
  </schema>
</schemalist>
