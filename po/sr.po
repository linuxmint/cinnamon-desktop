#: libcinnamon-desktop/gnome-languages.c:701
msgid "Unspecified"
msgstr ""

#. Date/Time format defaults - options are stored in org.cinnamon.desktop.interface keys.
#. * The wall clock is used variously in Cinnamon applets and desklets, as well as
#. * cinnamon-screensaver's default lock screen.
#. Default date format (typically matching date portion of WITH_DATE_* defaults.)
#. * Currently used by cinnamon-screensaver default clock
#: libcinnamon-desktop/gnome-wall-clock.c:69
msgid "%A, %B %-e"
msgstr "%A, %-e. %B"

#. Default date/time format when show-date, show-seconds, use-24h are set
#: libcinnamon-desktop/gnome-wall-clock.c:72
msgid "%A %B %-e, %R:%S"
msgstr "%A, %-e. %B, %R:%S"

#. Default date/time format when show-date, show-seconds are set
#: libcinnamon-desktop/gnome-wall-clock.c:75
msgid "%A %B %-e, %-l:%M:%S %p"
msgstr "%A, %-e. %B, %-l:%M:S"

#. Default date/time format when show-date, use-24h are set
#: libcinnamon-desktop/gnome-wall-clock.c:78
msgid "%A %B %-e, %R"
msgstr "%A, %-e. %B, %R"

#. Default date/time format when just show-date is set
#: libcinnamon-desktop/gnome-wall-clock.c:81
msgid "%A %B %-e, %-l:%M %p"
msgstr "%A, %-e. %B, %-l:%M"

#. Default date/time format when show-seconds, use-24h are set
#: libcinnamon-desktop/gnome-wall-clock.c:84
msgid "%R:%S"
msgstr "%R:%S"

#. Default date/time format when just show-seconds is set
#: libcinnamon-desktop/gnome-wall-clock.c:87
msgid "%-l:%M:%S %p"
msgstr "%-l:%M:%S"

#. Default date/time format when just use-24h is set
#: libcinnamon-desktop/gnome-wall-clock.c:90
msgid "%R"
msgstr "%R"

#. Default date/time format with no options are set
#: libcinnamon-desktop/gnome-wall-clock.c:93
msgid "%-l:%M %p"
msgstr "%-l:%M"
